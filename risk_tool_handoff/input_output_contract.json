{
  "tool_name": "risk_assessment_tool",
  "status": "experimental_not_clinically_validated",
  "inputs": {
    "patient_data": {
      "required": [
        "age",
        "anaemia",
        "creatinine_phosphokinase",
        "diabetes",
        "ejection_fraction",
        "high_blood_pressure",
        "platelets",
        "serum_creatinine",
        "serum_sodium",
        "sex",
        "smoking"
      ],
      "binary_fields": [
        "anaemia",
        "diabetes",
        "high_blood_pressure",
        "sex",
        "smoking"
      ],
      "additional_fields_allowed": false
    },
    "horizon_days": {
      "type": "number",
      "default": 100,
      "must_be_greater_than": 0
    }
  },
  "success_output": [
    "status",
    "risk_assessed",
    "horizon_days",
    "survival_probability",
    "event_probability",
    "model"
  ],
  "error_output": [
    "status",
    "risk_assessed",
    "error.code",
    "error.message"
  ],
  "missing_data_policy": "Reject incomplete input; do not infer or fabricate clinical values.",
  "risk_interpretation": "Report probabilities only. Do not assign unsupported risk categories."
}